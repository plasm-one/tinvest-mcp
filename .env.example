# ---------------------------------------------------------------------------
# tinvest-mcp — SECRETS ONLY
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Nothing but tokens belongs here; every other
# setting lives in config.toml (which is safe to commit — this file is not).
#
#   cp .env.example .env
#   chmod 600 .env
#
# Where to get a token: T-Bank Invest → Settings → API tokens
#   web:    https://www.tbank.ru/invest/settings/api/
#   docs:   https://developer.tbank.ru/invest/intro/intro/token
# A token is shown ONCE at creation and cannot be recovered. Losing it means
# revoking and issuing a new one.
#
# The server reads whichever token the active mode needs and never logs it.
# See docs/security.md for the full threat model.
# ---------------------------------------------------------------------------


# --- Sandbox (default mode) -------------------------------------------------
# Virtual money on T-Bank's own sandbox servers. Real orders are impossible
# here whatever the agent does, which makes it the right place to start.
# Token scope: "Read-only" is enough for sandbox trading.
TINVEST_SANDBOX_TOKEN=


# --- Production: research token (least privilege) ---------------------------
# Scope at creation: READ-ONLY. Every read the agent performs uses this one.
# With only this token set, placing an order is structurally impossible — not
# "discouraged", impossible: the execution path has no credential to use.
# This is the recommended production setup.
TINVEST_READONLY_TOKEN=


# --- Production: execution token (dangerous) --------------------------------
# Scope at creation: FULL ACCESS. Required ONLY if you intend to let this
# server place real orders, and only together with BOTH flags in config.toml:
#
#   [tinvest]
#   mode = "prod"
#   enable_real_trading = true
#
# Leave EMPTY unless that is deliberately what you want. Must differ from
# TINVEST_READONLY_TOKEN — the server warns at startup when they match.
#
# Do NOT grant the "transfers / money movement" scope. This server never needs
# it, and a token that can move cash turns a config leak into a withdrawal.
TINVEST_FULLACCESS_TOKEN=


# --- Optional: explicit file locations --------------------------------------
# An MCP client starts the server with an arbitrary working directory, so the
# server searches for config.toml/.env upward from the cwd and then in
# ~/.config/tinvest-mcp/. Set these to skip the search entirely.
#
# TINVEST_MCP_CONFIG=/Users/me/.config/tinvest-mcp/config.toml
# TINVEST_MCP_ENV_FILE=/Users/me/.config/tinvest-mcp/.env
# TINVEST_MCP_STATE_DIR=/Users/me/.local/state/tinvest-mcp
